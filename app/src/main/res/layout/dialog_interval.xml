<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etIntervalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/interval_name_hint"
        android:inputType="text"
        android:textColorHint="@color/text_hint" />

    <Spinner
        android:id="@+id/spinnerPhaseType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/etIntervalDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/duration_seconds"
        android:inputType="number"
        android:textColorHint="@color/text_hint" />

    <EditText
        android:id="@+id/etIntervalRepetitions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/repetitions_optional"
        android:inputType="number"
        android:textColorHint="@color/text_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIntervalMediaPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_input"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_media"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/btnIntervalMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:padding="8dp"
            android:text="@string/media"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
